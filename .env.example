# Supabase — Vite (local) OR Vercel Supabase integration names both work.
# Prefer VITE_* locally. On Vercel, the integration's NEXT_PUBLIC_* keys are enough.

# Local / explicit Vite names
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Optional aliases (same values as Vercel integration)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Google OAuth (also enable Google provider in Supabase Auth settings)
VITE_GOOGLE_CLIENT_ID=

# Optional: OpenRouter API key for the AI support chat (https://openrouter.ai/keys)
# Free models are used by default; without a key the chat falls back to canned replies.
VITE_OPENROUTER_API_KEY=

# Optional: override the primary OpenRouter model (falls back to a free-model chain)
# VITE_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Do NOT put SUPABASE_SERVICE_ROLE_KEY or POSTGRES_* in client env — server-only secrets.
