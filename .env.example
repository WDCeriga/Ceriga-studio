# Supabase — Vite (local) OR Vercel Supabase integration names both work.
# Prefer VITE_* locally. On Vercel, the integration's NEXT_PUBLIC_* keys are enough.

# Local / explicit Vite names
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Optional aliases (same values as Vercel integration)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Google OAuth (also enable Google provider in Supabase Auth settings)
VITE_GOOGLE_CLIENT_ID=

# Optional: collar photo → line art on the neck step (Google AI Studio, free).
# Restart `npm run dev` after adding a key.
GEMINI_API_KEY=
# Optional fallback for the same collar-from-photo pipeline
# OPENAI_API_KEY=
